# Disjoint execution categories; keep exact GTest/CTest names and every assertion.
function(stratadrive_discover_tests target)
    if(target STREQUAL "m4_fault_test")
        set(pure "M4FaultContract.*:M4ExecutionWatch.*:M4ReleaseGrid.*")
        set(wall "M4FaultWall.*:Independent/M4GuardWall.*")
    elseif(target STREQUAL "m4_async_runtime_test")
        set(pure "")
        set(wall "M4AsyncWall.*")
    elseif(target STREQUAL "session_coordinator_test")
        set(pure "ManagerTest.*:SessionParticipant.*:SessionMailbox.*:SessionReset.*")
        set(wall "SessionLoops.EightIndependentOwnerThreadsExchangeOnlyTypedMailboxes")
    elseif(target STREQUAL "periodic_task_test")
        set(wall "LatestSnapshot.ConcurrentOwnerCopiesCannotTearOrRegressAnAcquisition")
        gtest_discover_tests(${target} TEST_FILTER "*-${wall}" DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "unit")
        gtest_discover_tests(${target} TEST_FILTER "${wall}" DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "runtime.wall")
        return()
    elseif(target MATCHES "^(async_owner_test|rear_power_gateway_test|command_gateway_test)$")
        gtest_discover_tests(${target} DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "integration.logical")
        return()
    else()
        gtest_discover_tests(${target} DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "unit")
        return()
    endif()
    if(pure)
        gtest_discover_tests(${target} TEST_FILTER "${pure}" DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "unit")
        set(exclude "${pure}:${wall}")
    else()
        set(exclude "${wall}")
    endif()
    gtest_discover_tests(${target} TEST_FILTER "*-${exclude}" DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "integration.logical")
    gtest_discover_tests(${target} TEST_FILTER "${wall}" DISCOVERY_MODE PRE_TEST PROPERTIES LABELS "runtime.wall")
endfunction()
