upports multiple vision tasks, including object detection, instance segmentation, and human pose estimation!"},{"sha":"37efa07d593fa8438785fbae0c21f94ba72162a5","filename":"figures/deimv2_coco_AP_vs_GFLOPs.png","status":"removed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/blob/e658301c11a29c4e34a8b1cb82b282c9bb8d206d/figures%2Fdeimv2_coco_AP_vs_GFLOPs.png","raw_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/raw/e658301c11a29c4e34a8b1cb82b282c9bb8d206d/figures%2Fdeimv2_coco_AP_vs_GFLOPs.png","contents_url":"https://api.github.com/repos/Intellindust-AI-Lab/DEIMv2/contents/figures%2Fdeimv2_coco_AP_vs_GFLOPs.png?ref=e658301c11a29c4e34a8b1cb82b282c9bb8d206d"},{"sha":"89f104c40e3ff53cfe9f9a1d1514b99e82aaf002","filename":"figures/deimv2_coco_AP_vs_Params.png","status":"removed","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/blob/e658301c11a29c4e34a8b1cb82b282c9bb8d206d/figures%2Fdeimv2_coco_AP_vs_Params.png","raw_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/raw/e658301c11a29c4e34a8b1cb82b282c9bb8d206d/figures%2Fdeimv2_coco_AP_vs_Params.png","contents_url":"https://api.github.com/repos/Intellindust-AI-Lab/DEIMv2/contents/figures%2Fdeimv2_coco_AP_vs_Params.png?ref=e658301c11a29c4e34a8b1cb82b282c9bb8d206d"},{"sha":"5f5e69acb9d9930b0370d9c01c4d2feefe0a8b3d","filename":"figures/teaser_a.png","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/blob/f005f50ce565e63f6c298feccb51901a98c3d035/figures%2Fteaser_a.png","raw_url":"https://github.com/Intellindust-AI-Lab/DEIMv2/raw/f005f50ce565e63f6c298feccb51901a98c3d035/figures%2Fteaser_a.png","contents_url":"https://api.github.com/repos/Intellindust-AI-Lab/DEIMv2/contents/figures%2Fteaser_a.png?ref=f005f50ce565e63f6c298feccb51901a98c3d035"},{"sha":"0a415b5676ed242f799ba5ed6d1e77b8836e5cae","filename":"figures/teaser_b.png","status":"added","additions":0,"del