+                    lease=stop_selection(proof,a,now,lease,causal);held+=1
+                    check(lease[2]>=trigger and (lease[2]-trigger)%20000000==0 and lease[1]==(lease[2]-trigger)//20000000,'stop issuer original 20ms roots')
