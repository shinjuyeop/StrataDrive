+    rejected[name]=bad.stderr.strip()
+report=dict(status='PASS_STOP30_CLI_SCOPE',prefix_observations=len(rows),rejected=rejected,physics_executed=False,binary_sha256=hashlib.sha256(a.binary.read_bytes()).hexdigest())
