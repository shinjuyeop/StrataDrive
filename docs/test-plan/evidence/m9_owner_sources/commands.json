{
  "normal_build": "cmake --build build/m1-angle -j 4",
  "normal_test": "ctest --test-dir build/m1-angle -L '^(unit|integration.logical)$' --output-on-failure -j 4",
  "asan_configure": "cmake -S . -B build/m1-angle-sanitized -DCMAKE_BUILD_TYPE=Debug -DSTRATADRIVE_SANITIZERS=ON",
  "asan_build": "cmake --build build/m1-angle-sanitized --target owner_diagnostics_test owner_diagnostics_sil_test zone_feedback_monitor_test async_owner_test m4_async_runtime_test m4_fault_test control_diagnostics_sil_test control_recovery_sil_test remote_leaf_test m6_physical_response_test -j 4",
  "asan_test": "ASAN_OPTIONS=detect_leaks=1:halt_on_error=1 UBSAN_OPTIONS=halt_on_error=1 ctest --test-dir build/m1-angle-sanitized -L '^(unit|integration.logical)$' -R '^(OwnerDiagnostics|ZoneFeedbackTest|AsyncOwnerTest|M4|ControlDiagnosticsSil|ControlRecoverySil|Remote|M6Physical)' --output-on-failure -j 2",
  "export": "STRATADRIVE_M9_OWNER_EVIDENCE=NEW_OUTPUT BUILD/owner_diagnostics_sil_test --gtest_output=xml:NEW_XML",
  "audit": "python3 tests/integration/diagnostics/audit_owner_diagnostics.py NEW_OUTPUT/upstream-pause --mutations; normal audit without --mutations",
  "wall": "ctest --test-dir build/m1-angle -R '^M4AsyncWall\\.' --output-on-failure",
  "clang_tidy": "clang-tidy -p build/m1-angle central/diagnostics/owner_diagnostics.cpp zone/feedback/zone_feedback_monitor.cpp zone/gateway/async_zone_owner.cpp simulation/runtime/async_leaf_owner.cpp simulation/runtime/m4_async_runtime.cpp simulation/runtime/m4_owner_network.cpp simulation/runtime/m4_result.cpp --quiet",
  "cppcheck": "cppcheck --project=build/m9-owner-work/compilation-subset.json --enable=warning,performance,portability --error-exitcode=1 --inline-suppr --suppress=missingIncludeSystem",
  "release_configure": "cmake -S . -B build/m9-diagnostics-release -DBUILD_TESTING=OFF -DCMAKE_BUILD_TYPE=Release",
  "release_build": "cmake --build build/m9-diagnostics-release --target owner_diagnostics m4_async_runtime -j 4",
  "fingerprint": "python3 tests/unit/m4_source_fingerprint_test.py"
}
